    <string name="security_settings_fingerprint_enroll_repeat_title">松开手指，然后轻触。每次都轻轻地移动手指。</string>
    <string name="security_settings_fingerprint_enroll_repeat_title_immobile_overlay">移开手指，再次触摸传感器</string>
